<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest additions. The host activity below exists solely on the unit-test
  classpath (SearchScreenRecreationTest); declaring it here is what lets Robolectric — which
  reads this merged debug manifest — launch it via ActivityScenario. The class is absent
  from the APK, so nothing shipped can ever start it, and the release manifest never sees
  this file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="pl.kwitukiewicz.handygerman.artikel.ui.SearchScreenRecreationTestHost"
            android:exported="false"
            tools:ignore="MissingClass" />
    </application>

</manifest>
